{
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "Lua.workspace.library": [
        "_sanity.lua"
    ],
    "files.associations": {
        "**/blog/md/*.txt": "html",
        "**/*.html.j2": "jinja-html"
    },
    "search.exclude": {
        "www/assets/ruffle/**": true,
    },
    "[html]": {
        "editor.formatOnSave": false
    },
    "[jinja-html]": {
        "editor.formatOnSave": false
    },
    "[scss]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
}
