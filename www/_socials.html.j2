{% import "_icons.html" as icons %}

{% macro link(title, href, icon = icons.fa("globe"), blank = True) %}
<li>{{ icon }} <a href="{{ href }}" {% if blank -%}target="_blank"{%- endif %}>{{- title -}}</a></li>
{% endmacro %}

