<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {% set base = "https://nonk.dev" %}

    {% for section in sections %}
    <url>
        <loc>{{ base }}{% if section.url != "/" %}{{ section.url | safe }}{% endif %}</loc>
        <lastmod>{{ section.lastmod | safe }}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
    {% endfor %}

    {% for id, article in blog.articles | items %}
    {% if not article.hidden and id != blog.default %} {# /blog is covered by the `sections` snippet above #}
    <url>
        <loc>{{ base }}/blog/{{ id }}</loc>
        <lastmod>{{ article.date_mod if article.date_mod else article.date_pub }}</lastmod>
        <priority>0.7</priority>
    </url>
    {% endif %}
    {% endfor %}
</urlset>
